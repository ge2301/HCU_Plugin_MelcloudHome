# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Runtime image for the HCU (ARM64). No frontend build stage — configuration
# happens entirely through the HCUweb form (Connect API CONFIG_TEMPLATE).
# ---------------------------------------------------------------------------
FROM --platform=linux/arm64 ghcr.io/homematicip/alpine-node-simple:0.0.1

ARG VERSION=0.1.0

WORKDIR /app

# Install production dependencies of the plugin
COPY plugin/package*.json ./
RUN npm install --omit=dev

# Copy the plugin source
COPY plugin/src ./src

# WebUI static assets (logo shown in the config page header)
COPY plugin/assets ./assets

# Persistent plugin data lives in /data (provided/mounted by the HCU;
# created here so local runs work too).
RUN mkdir -p /data

# Expose the embedded WebUI port (the HCU maps exposed ports 1:1)
EXPOSE 5300

# argv: <pluginId> <hcuHost> <authTokenFile>
ENTRYPOINT ["node", "src/index.js", "de.community.homematic.plugin.melcloud", "host.containers.internal", "/TOKEN"]

# Plugin metadata read by the HCU when installing the image
LABEL de.eq3.hmip.plugin.metadata=\
'{\
	"pluginId": "de.community.homematic.plugin.melcloud",\
	"issuer": "Gerrit Eßers",\
	"version": "1.0.0",\
	"hcuMinVersion": "1.4.7",\
	"scope": "CLOUD",\
	"friendlyName": {\
		"en": "Mitsubishi MELCloud Home",\
		"de": "Mitsubishi MELCloud Home"\
	},\
	"description": {\
		"en": "Integrates Mitsubishi MELCloud Home air conditioner units (temperature, power and operation mode) into Homematic IP via the MELCloud Home cloud API.",\
		"de": "Bindet Mitsubishi-Klimageraete aus MELCloud Home (Temperatur, An/Aus und Betriebsart) ueber die MELCloud-Home-Cloud in Homematic IP ein."\
	},\
	"image": "",\
	"changelog": "Version 1.0.0\\n- Erstfassung: Anzeige von Soll-/Ist-Temperatur, An/Aus und Betriebsart je Klima-Innengeraet (nur lesend).",\
	"logsEnabled": true\
}'
